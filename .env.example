# Supabase project URL (from Project Settings → API)
SUPABASE_URL=

# Supabase anonymous/public key — safe to expose in browser
SUPABASE_ANON_KEY=

# Supabase service-role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Browser Use Cloud API key for remote browser sessions (required when CAPTURE_BROWSER_MODE is remote)
BROWSER_USE_API_KEY=

# Browser Use residential proxy, on or off (default: off)
BROWSER_USE_PROXY=

# Browser Use session timeout in minutes, integer 1 to 5 (default: 1)
BROWSER_USE_SESSION_TIMEOUT_MINUTES=

# Page capture browser mode (default: remote; only remote is implemented)
CAPTURE_BROWSER_MODE=

# Page capture WebSocket hardening, on or off (default: on)
CAPTURE_WEBSOCKET_HARDENING=

# Anthropic API key for Claude Haiku 5.5 (LLM judge — primary)
ANTHROPIC_API_KEY=

# Google Gemini API key for Gemini 2.5 Flash-Lite (LLM judge — fallback)
GEMINI_API_KEY=

# Canonical public origin of the deployed app (used for absolute links and og: tags; bypasses no page capture check)
NEXT_PUBLIC_APP_URL=

# Test-only capture fixture routes under /capture-fixture, served only when exactly "on" (default: off, keep off in production)
CAPTURE_FIXTURE_ROUTES=

# https origin of a second host name of this deployment, embedded by the fixture page as its cross-site frame (optional)
CAPTURE_FIXTURE_ALT_ORIGIN=

# Live test only: origin of a deployment that serves the fixture routes (optional)
LIVE_FIXTURE_BASE_URL=

# Live test only: https origin of the same deployment on another site, the same value as CAPTURE_FIXTURE_ALT_ORIGIN there (optional)
LIVE_FIXTURE_ALT_BASE_URL=
