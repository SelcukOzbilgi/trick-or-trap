{
  "name": "builder",
  "description": "Build agent for Trick or Trap. Kiro's file tools are allowed only inside this repository; shell is limited to an allow list. Not a hard sandbox: allowed npm and npx commands can run arbitrary code.",
  "tools": ["*"],
  "resources": ["file://.kiro/steering/**/*.md"],
  "permissions": {
    "rules": [
      { "capability": "fs_read",  "match": ["./**"], "effect": "allow" },
      { "capability": "fs_write", "match": ["./**"], "effect": "allow" },
      { "capability": "fs_read",  "match": ["./.env", "./.env.*"], "exclude": ["./.env.example"], "effect": "deny" },
      { "capability": "fs_write", "match": ["./.env", "./.env.*"], "exclude": ["./.env.example"], "effect": "deny" },
      { "capability": "fs_write", "match": ["./.kiro/agents/**", "./.kiro/hooks/**", "./.kiro/settings/**", "./.git/**", "./.gitattributes", "./.npmrc"], "effect": "deny" },
      { "capability": "shell",
        "match": ["npm install*", "npm ci*", "npm run *", "npm test*", "npx create-next-app*", "npx shadcn*", "npx playwright*", "npx tsc*", "npx vitest*", "npx eslint*", "npx next *", "node --test*", "node --version"],
        "exclude": ["*..*", "* /*", "* ~*", "*$*", "*`*", "*;*", "*&&*", "*|*", "*>*", "*&*", "*<*", "*(*", "*)*", "*run dev*", "*next dev*", "*next start*", "*run start*", "*--watch*"],
        "effect": "allow" }
    ]
  }
}
